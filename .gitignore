# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# The Slicer build byte-compiles to LEGACY sibling .pyc files (GTReview.pyc
# next to GTReview.py) rather than __pycache__/. The scripted-module factory
# will happily load a .pyc when no .py is present, so a stale one left in the
# source tree can shadow a module you deleted. Keep them out of git.
GTReview/*.pyc
GTReview/GTReviewLib/*.pyc

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environments
.env
.venv
env/
venv/
ENV/

# Test / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.hypothesis/

# Type checkers / linters
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/

# --- CMake / build artefacts ------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
Testing/Temporary/
CMakeUserPresets.json
compile_commands.json
Makefile
*.cmake.tmp

# Out-of-source build trees (never build in-tree)
build/
build-*/
*-build/
_build/

# Generated by the Slicer extension build; never hand-authored or committed.
GTReview.s4ext
*.s4ext

# Packages produced by CPack
*.tar.gz
# ...except the built extension packages.  Packages/ rather than dist/,
# because dist/ is ignored wholesale by the python block below and git
# will not descend into an ignored directory to honour an exception.
!Packages/*.tar.gz
*.zip

# --- Editors / OS -----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Data --------------------------------------------------------------------
# Never commit patient data or review outputs.
*.nii
*.nii.gz
